+package com.watabou.pixeldungeon.sprites;
+
+import java.util.ArrayList;
+
+import com.watabou.noosa.particles.Emitter;
+import com.watabou.pixeldungeon.actors.Char;
+import com.watabou.pixeldungeon.levels.Level;
+import com.watabou.utils.Callback;
+import com.watabou.utils.PointF;
+import com.watabou.utils.Random;
+
+/**
+ * HEADLESS addition (not in the original game).
+ *
+ * A CharSprite with no graphics. Every visual method is a no-op. Methods whose
+ * animation completion drives game logic (attack / operate / jump / attack-with-callback)
+ * queue the completion; the driver calls {@link #flush()} after Actor.process() returns,
+ * which emulates "the animation finished on a later frame" exactly like the real game loop.
+ * move() calls ch.onMotionComplete() synchronously, as the original CharSprite.move() does.
+ */
+public class HeadlessSprite extends CharSprite {
+
+	private static final ArrayList<Runnable> pending = new ArrayList<Runnable>();
+
+	/** Optional trace hook for status texts (damage numbers etc). */
+	public static boolean TRACE = false;
+
+	public static HeadlessSprite attach( Char ch ) {
+		HeadlessSprite s = new HeadlessSprite();
+		s.link( ch );
+		return s;
+	}
+
+	/** Runs queued animation completions. Returns true if anything ran. */
+	public static boolean flush() {
+		if (pending.isEmpty()) return false;
+		ArrayList<Runnable> copy = new ArrayList<Runnable>( pending );
+		pending.clear();
+		for (Runnable r : copy) r.run();
+		return true;
+	}
+
+	public static void clearPending() {
+		pending.clear();
+	}
+
+	public HeadlessSprite() {
+		super();
+	}
+
+	@Override
+	public void link( Char ch ) {
+		this.ch = ch;
+		ch.sprite = this;
+		// original link() consumes one random number in turnTo( ch.pos, Random.Int( Level.LENGTH ) )
+		Random.Int( Level.LENGTH );
+		ch.updateSpriteState();
+	}
+
+	@Override public PointF worldToCamera( int cell ) { return new PointF(); }
+	@Override public void place( int cell ) {}
+	@Override public void showStatus( int color, String text, Object... args ) {
+		if (TRACE) {
+			System.out.println( "  [status " + (ch != null ? ch.name : "?") + "] " +
+				(args.length > 0 ? String.format( text, args ) : text) );
+		}
+	}
+	@Override public void idle() {}
+	@Override public void move( int from, int to ) {
+		isMoving = false;
+		ch.onMotionComplete();
+	}
+	@Override public void interruptMotion() {}
+	@Override public void attack( int cell ) {
+		final Char c = ch;
+		pending.add( new Runnable() { public void run() { c.onAttackComplete(); } } );
+	}
+	@Override public void attack( int cell, final Callback callback ) {
+		pending.add( new Runnable() { public void run() { callback.call(); } } );
+	}
+	@Override public void operate( int cell ) {
+		final Char c = ch;
+		pending.add( new Runnable() { public void run() { c.onOperateComplete(); } } );
+	}
+	@Override public void zap( int cell ) {}
+	@Override public void turnTo( int from, int to ) {}
+	@Override public void jump( int from, int to, final Callback callback ) {
+		pending.add( new Runnable() { public void run() { if (callback != null) callback.call(); } } );
+	}
+	@Override public void die() {}
+	@Override public Emitter emitter() { return new Emitter(); }
+	@Override public Emitter centerEmitter() { return new Emitter(); }
+	@Override public Emitter bottomEmitter() { return new Emitter(); }
+	@Override public void burst( int color, int n ) {}
+	@Override public void bloodBurstA( PointF from, int damage ) {}
+	@Override public void flash() {}
+	@Override public void add( State state ) {}
+	@Override public void remove( State state ) {}
+	@Override public void update() {}
+	@Override public void showSleep() {}
+	@Override public void hideSleep() {}
+	@Override public void showAlert() {}
+	@Override public void hideAlert() {}
+	@Override public void kill() {}
+	@Override public void draw() {}
+}
